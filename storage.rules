rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /instagram/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /users/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

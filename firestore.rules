rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }
    
    match /orders/{orderId} {
      // Validate incoming order payload
      function isValidOrder() {
        let data = request.resource.data;
        return data.keys().hasAll(['total', 'items', 'customerName', 'status']) &&
               data.status == 'pending' &&
               data.total is number &&
               data.items is list &&
               data.items.size() > 0;
      }

      // Allow everyone to create an order securely with validation
      allow create: if isValidOrder();
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow read, write: if isAdmin();
    }
    
    match /products/{productId} {
      // Read access to everyone
      allow read: if true;
      // Allow clients to decrement stockQuantity and increment orderCount during checkout
      // All other writes (create, delete, full update) remain admin-only
      allow update: if isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stockQuantity', 'inStock', 'orderCount']) &&
          request.resource.data.stockQuantity is int &&
          request.resource.data.stockQuantity >= 0 &&
          request.resource.data.stockQuantity <= resource.data.stockQuantity &&
          request.resource.data.inStock is bool &&
          request.resource.data.inStock == (request.resource.data.stockQuantity > 0) &&
          request.resource.data.orderCount is int &&
          request.resource.data.orderCount >= resource.data.orderCount
        );
      allow create, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      // Read access to everyone
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instagramFeed/{slotId} {
      // Public homepage can read Instagram feed slots
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productName is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.content is string
        && request.resource.data.imageUrls is list
        && request.resource.data.approved == true;
      allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      // Everyone can read site settings (announcement, bank info, etc)
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

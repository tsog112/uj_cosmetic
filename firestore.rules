rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }
    
    match /orders/{orderId} {
      // Validate incoming order payload
      function isValidOrder() {
        let data = request.resource.data;
        return data.keys().hasAll(['total', 'items', 'customerName', 'status']) &&
               data.status == 'pending' &&
               data.total is number &&
               data.items is list &&
               data.items.size() > 0;
      }

      // Allow everyone to create an order securely with validation
      allow create: if isValidOrder();
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow read, write: if isAdmin();
    }
    
    match /products/{productId} {
      // Read access to everyone
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      // Read access to everyone
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      // Everyone can read site settings (announcement, bank info, etc)
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    match /users/{uid}/wishlist/{productId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }
    
    match /user_addresses/{addressId} {
      allow read, update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin());
    }
    
    match /orders/{orderId} {
      // Validate incoming order payload
      function isValidOrder() {
        let data = request.resource.data;
        let hasRequiredFields = data.keys().hasAll(['total', 'items', 'customerName', 'status', 'userId']);
        let isStatusPending = data.status == 'pending';
        let isAuthConsistent = request.auth == null || data.userId == request.auth.uid;
        
        return hasRequiredFields && isStatusPending && isAuthConsistent &&
               data.total is number &&
               data.items is list &&
               data.items.size() > 0;
      }

      // Orders are created through /api/orders/create so stock validation and
      // inventory decrement happen in one trusted server transaction.
      allow create: if false;
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }
    
    match /products/{productId} {
      // Product documents contain private inventory counts. Public product reads
      // are served through /api/products with a minimized DTO.
      allow read, write: if isAdmin();
    }

    match /categories/{categoryId} {
      // Read access to everyone
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instagramFeed/{slotId} {
      // Public homepage can read Instagram feed slots
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      // Public reviews are served through /api/reviews with masked names and no
      // customer identifiers. Direct reads are limited to the author or admin.
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'productId', 'productSlug', 'productName', 'userId', 'userName',
          'userEmail', 'rating', 'content', 'imageUrls', 'approved',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == ''
        && request.resource.data.productId is string
        && request.resource.data.productName is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.content is string
        && request.resource.data.imageUrls is list
        && request.resource.data.approved == true;
      allow update: if isAdmin() ||
        (
          request.auth != null
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'content', 'imageUrls', 'updatedAt'])
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.content is string
          && request.resource.data.imageUrls is list
        );
      allow delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    match /settings/{settingId} {
      // Everyone can read site settings (announcement, bank info, etc)
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

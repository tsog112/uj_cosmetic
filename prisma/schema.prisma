generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  phone     String?
  email     String?  @unique
  role      String   @default("customer")
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  brand       String?
  description String?
  ingredients String?
  howToUse    String?
  price       Float
  salePrice   Float?
  stock       Int      @default(0)
  isVisible   Boolean  @default(true)
  images      String   // JSON string array of URLs
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  customerName    String?
  customerPhone   String?
  status          String      @default("PENDING")
  total           Float
  shippingAddress String?
  addressSnapshot String?     // JSON string of AddressSnapshot
  archived        Boolean     @default(false)
  archivedAt      DateTime?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Setting {
  id    String @id @default("MAIN")
  key   String @unique
  value String // JSON string
}

model MnRegion {
  id        String       @id
  type      String       // 'aimag' | 'city'
  nameMn    String
  nameShort String
  sortOrder Int
  districts MnDistrict[]
}

model MnDistrict {
  id        String     @id
  regionId  String
  region    MnRegion   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  type      String     // 'duureg' | 'sum'
  nameMn    String
  nameShort String
  sortOrder Int
  khoroos   MnKhoroo[]
}

model MnKhoroo {
  id         String     @id
  districtId String
  district   MnDistrict @relation(fields: [districtId], references: [id], onDelete: Cascade)
  type       String     // 'khoroo' | 'bag'
  nameMn     String
  sortOrder  Int
}

model UserAddress {
  id          String   @id @default(cuid())
  userId      String
  label       String   // "Гэр", "Ажил", "Бусад"
  regionId    String
  districtId  String
  khorooId    String
  detail      String
  fullAddress String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

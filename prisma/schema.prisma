generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String        @id @default(cuid())
  name                 String?
  displayName          String?
  phone                String?
  email                String        @unique
  emailVerified        Boolean       @default(false)
  emailVerifiedAt      DateTime?
  emailVerifyToken     String?       @unique
  passwordHash         String?
  googleId             String?       @unique
  googleEmail          String?
  googleAvatarUrl      String?
  passwordResetToken   String?       @unique
  passwordResetExpires DateTime?
  role                 String        @default("customer")
  orders               Order[]
  reviews              Review[]
  addresses            UserAddress[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([role])
  @@index([createdAt])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  nameMn      String?
  image       String?
  icon        String?
  color       String?
  showOnHome  Boolean   @default(false)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id              String      @id @default(cuid())
  slug            String      @unique
  name            String
  nameMn          String?
  nameEn          String?
  brand           String?
  description     String?
  descriptionMn   String?
  ingredients     String?
  howToUse        String?
  price           Float
  salePrice       Float?
  saleEndDate     DateTime?
  costPrice       Float?
  stock           Int         @default(0)
  stockQuantity   Int         @default(0)
  lowStockThreshold Int       @default(5)
  isVisible       Boolean     @default(true)
  published       Boolean     @default(true)
  featured        Boolean     @default(false)
  featuredSince   DateTime?
  featuredUntil   DateTime?
  featuredPosition String?    @default("home")
  showFeaturedBadge Boolean   @default(true)
  showOnHome      Boolean     @default(false)
  showcaseFeatured Boolean    @default(false)
  showcaseNewest  Boolean     @default(false)
  showcaseSale    Boolean     @default(false)
  images          Json        @default("[]")
  videoUrl        String?
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
  reviews         Review[]
  views           Int         @default(0)
  orderCount      Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([categoryId])
  @@index([published, updatedAt])
  @@index([featured])
  @@index([stock])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String?     @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  phone           String?
  status          String      @default("pending")
  subtotal        Float       @default(0)
  shippingCost    Float       @default(0)
  discount        Float       @default(0)
  total           Float
  promoCode       String?
  shippingAddress String?
  addressSnapshot Json?
  market          String      @default("MN")
  currency        String      @default("MNT")
  paymentMethod   String?
  paymentStatus   String?     @default("unpaid")
  qpayInvoiceId   String?
  paymentMeta     Json?
  archived        Boolean     @default(false)
  archivedAt      DateTime?
  items           OrderItem[]
  reviews         Review[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([archived, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String?
  imageUrl  String?
  quantity  Int
  price     Float

  @@index([orderId])
  @@index([productId])
}

model Review {
  id               String   @id
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productSlug      String?
  productName      String?
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName         String?
  userEmail        String?
  rating           Int
  content          String
  body             String?
  imageUrls        Json     @default("[]")
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status           String   @default("pending")
  approved         Boolean  @default(false)
  featured         Boolean  @default(false)
  verifiedPurchase Boolean  @default(true)
  editCount        Int      @default(0)
  adminReply       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, productId, orderId])
  @@index([productId, status, createdAt])
  @@index([status, featured])
}

model AdminMetric {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default("MAIN")
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model Expense {
  id        String   @id @default(cuid())
  title     String
  amount    Float
  category  String
  date      DateTime
  createdAt DateTime @default(now())

  @@index([date])
}

model Notification {
  id           String   @id @default(cuid())
  type         String
  userId       String?
  orderId      String?
  title        String
  body         String
  href         String?
  channel      String?
  status       String   @default("unread")
  scheduledFor DateTime?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model MnRegion {
  id        String       @id
  type      String
  nameMn    String
  nameShort String
  sortOrder Int
  districts MnDistrict[]
}

model MnDistrict {
  id        String     @id
  regionId  String
  region    MnRegion   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  type      String
  nameMn    String
  nameShort String
  sortOrder Int
  khoroos   MnKhoroo[]

  @@index([regionId])
}

model MnKhoroo {
  id         String     @id
  districtId String
  district   MnDistrict @relation(fields: [districtId], references: [id], onDelete: Cascade)
  type       String
  nameMn     String
  sortOrder  Int

  @@index([districtId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

model ReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}

model UserAddress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String?
  regionId    String
  districtId  String
  khorooId    String
  detail      String
  fullAddress String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}
